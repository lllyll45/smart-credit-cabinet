# Шаблон локальных настроек Smart Credit Cabinet.
# Скопируйте в .env и задайте свои значения. Файл .env не коммитить.

APP_NAME=Smart Credit Cabinet
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Backend запущен непосредственно на компьютере:
DATABASE_URL=postgresql+psycopg://smart_credit:change_me@localhost:5432/smart_credit

# Если backend работает внутри Docker Compose, используйте имя сервиса БД:
# DATABASE_URL=postgresql+psycopg://smart_credit:change_me@db:5432/smart_credit

JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
