# Шаблон локальных настроек Smart Credit Cabinet.
# Скопируйте этот файл в .env и задайте свои значения.
# Файл .env не коммитить — он в .gitignore.

APP_NAME=Smart Credit Cabinet
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

# Backend запущен непосредственно на компьютере:
# Замените YOUR_PASSWORD на пароль пользователя smart_credit в вашем PostgreSQL.
DATABASE_URL=postgresql+psycopg://smart_credit:YOUR_PASSWORD@localhost:5432/smart_credit

# Если backend работает внутри Docker Compose, используйте имя сервиса БД:
# DATABASE_URL=postgresql+psycopg://smart_credit:YOUR_PASSWORD@db:5432/smart_credit

# Сгенерируйте свой ключ командой:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# и вставьте результат вместо CHANGE_ME...
JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_urlsafe_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173