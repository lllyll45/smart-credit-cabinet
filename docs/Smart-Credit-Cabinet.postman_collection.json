{
  "info": {
    "name": "Smart Credit Cabinet API",
    "description": "Коллекция базовых запросов. После регистрации и входа токен сохраняется в переменную access_token. Точные схемы отдельных тел следует сверить с /docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "api_prefix",
      "value": "/api/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "application_id",
      "value": "1"
    },
    {
      "key": "recommendation_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"DemoPass123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const data = pm.response.json();",
                  "  if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "demo@example.com"
                },
                {
                  "key": "password",
                  "value": "DemoPass123"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Products and calculator",
      "item": [
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/products",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "products"
              ]
            }
          }
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/products/{{product_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "products",
                "{{product_id}}"
              ]
            }
          }
        },
        {
          "name": "Calculate payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{product_id}},\n  \"amount\": 500000,\n  \"term_months\": 24\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/calculator/calculate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "calculator",
                "calculate"
              ]
            }
          }
        },
        {
          "name": "Compare products",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500000,\n  \"term_months\": 24\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/calculator/compare",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "calculator",
                "compare"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Business profile",
      "item": [
        {
          "name": "Get profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/business-profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "business-profile"
              ]
            }
          }
        },
        {
          "name": "Upsert profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_name\": \"ООО Демобизнес\",\n  \"legal_form\": \"OOO\",\n  \"industry\": \"Торговля\",\n  \"region\": \"Москва\",\n  \"business_start_date\": \"2022-01-15\",\n  \"monthly_revenue\": 800000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/business-profile",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "business-profile"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Create draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credit_product_id\": {{product_id}},\n  \"amount\": 500000,\n  \"term_months\": 24,\n  \"purpose\": \"working_capital\",\n  \"monthly_income\": 250000,\n  \"employment\": \"Предприниматель\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "applications"
              ]
            }
          }
        },
        {
          "name": "List my applications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/applications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "applications"
              ]
            }
          }
        },
        {
          "name": "Get application",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/applications/{{application_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "applications",
                "{{application_id}}"
              ]
            }
          }
        },
        {
          "name": "Submit application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/applications/{{application_id}}/submit",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "applications",
                "{{application_id}}",
                "submit"
              ]
            }
          }
        },
        {
          "name": "Application history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/applications/{{application_id}}/history",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "applications",
                "{{application_id}}",
                "history"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Recommendations",
      "item": [
        {
          "name": "Create recommendations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requested_amount\": 500000,\n  \"term_months\": 24,\n  \"purpose\": \"working_capital\",\n  \"monthly_revenue\": 800000,\n  \"business_age_months\": 36\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/recommendations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "recommendations"
              ]
            }
          }
        },
        {
          "name": "Get saved recommendations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/recommendations/{{recommendation_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "recommendations",
                "{{recommendation_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
}